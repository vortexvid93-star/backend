{
  "info": {
    "_postman_id": "bibliotech-admin-auteurs-categories-v1",
    "name": "BiblioTech — Admin Auteurs & Catégories (§11)",
    "description": "Section **11 — Admin — Auteurs & Catégories** : CRUD complet, soft delete (`deleted_at`).\n\n**Prérequis**\n1. `npm run start:dev`\n2. `npm run db:seed` (auteurs/catégories `SEED-FULL`)\n3. Compte **ADMIN**\n\n**Ordre** : `0.1 Login` → Auteurs (11.1→11.4) → Catégories (11.5→11.8).\n\n**Variables** : `access_token`, `auteur_id`, `categorie_id`.\n\n**409** : suppression impossible si un défi `statut=ACTIF` référence l'auteur/catégorie (`defi` ON DELETE RESTRICT).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "admin_email", "value": "password@biblio.tech" },
    { "key": "admin_password", "value": "MonMotDePasse123" },
    { "key": "access_token", "value": "" },
    { "key": "auteur_id", "value": "" },
    { "key": "categorie_id", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const noAuth = ['0.1 Login admin'];",
          "if (noAuth.includes(pm.info.requestName)) return;",
          "if (!pm.collectionVariables.get('access_token')) {",
          "  console.warn('Lancez 0.1 Login admin.');",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "0 — Prérequis (JWT ADMIN)",
      "item": [
        {
          "name": "0.1 Login admin → access_token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "  pm.collectionVariables.set('access_token', pm.response.json().access_token.trim());",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/password/login"
          }
        }
      ]
    },
    {
      "name": "11.1–11.4 — Auteurs",
      "item": [
        {
          "name": "11.1 GET /admin/auteurs ★",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('pagination', () => pm.expect(j).to.have.keys('data','meta'));",
                  "if (j.data?.[0]) pm.collectionVariables.set('auteur_id', j.data[0].id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/admin/auteurs?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "auteurs"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "11.1 GET /admin/auteurs?q=Kouassi",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/admin/auteurs?q=Kouassi",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "auteurs"],
              "query": [{ "key": "q", "value": "Kouassi" }]
            }
          }
        },
        {
          "name": "11.2 POST /admin/auteurs ★",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201', () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('auteur_id', pm.response.json().id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nom\": \"Test-Admin\",\n  \"prenom\": \"Postman\",\n  \"bio\": \"Auteur créé via §11.2\"\n}"
            },
            "url": "{{baseUrl}}/admin/auteurs"
          }
        },
        {
          "name": "11.3 PATCH /admin/auteurs/:id ★",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "if (!pm.collectionVariables.get('auteur_id')) throw new Error('auteur_id manquant (11.1 ou 11.2).');"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.expect(pm.response.json()).to.have.property('updatedAt');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bio\": \"Biographie mise à jour §11.3\"\n}"
            },
            "url": "{{baseUrl}}/admin/auteurs/{{auteur_id}}"
          }
        },
        {
          "name": "11.4 DELETE /admin/auteurs/:id (soft delete) ★",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "if (!pm.collectionVariables.get('auteur_id')) throw new Error('auteur_id manquant.');"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 ou 409', () => pm.expect([200,409]).to.include(pm.response.code));",
                  "if (pm.response.code === 200) pm.expect(pm.response.json()).to.have.property('deleted_at');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/admin/auteurs/{{auteur_id}}"
          }
        }
      ]
    },
    {
      "name": "11.5–11.8 — Catégories",
      "item": [
        {
          "name": "11.5 GET /admin/categories ★",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "if (j.data?.[0]) {",
                  "  pm.collectionVariables.set('categorie_id', j.data[0].id);",
                  "  pm.test('nb_livres', () => pm.expect(j.data[0]).to.have.property('nb_livres'));",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/admin/categories?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "categories"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "11.5 GET /admin/categories?q=SEED-FULL",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/admin/categories?q=SEED-FULL",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "categories"],
              "query": [{ "key": "q", "value": "SEED-FULL" }]
            }
          }
        },
        {
          "name": "11.6 POST /admin/categories ★",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201', () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) pm.collectionVariables.set('categorie_id', pm.response.json().id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nom\": \"Admin-Test-Categorie-{{$timestamp}}\",\n  \"description\": \"Créée via Postman §11.6\"\n}"
            },
            "url": "{{baseUrl}}/admin/categories"
          }
        },
        {
          "name": "11.6 POST /admin/categories — doublon nom (→ 409)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('409', () => pm.response.to.have.status(409));"],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nom\": \"SEED-FULL — Romans\",\n  \"description\": \"Doublon volontaire\"\n}"
            },
            "url": "{{baseUrl}}/admin/categories"
          }
        },
        {
          "name": "11.7 PATCH /admin/categories/:id ★",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "if (!pm.collectionVariables.get('categorie_id')) throw new Error('categorie_id manquant.');"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('200', () => pm.response.to.have.status(200));"],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Description mise à jour §11.7\"\n}"
            },
            "url": "{{baseUrl}}/admin/categories/{{categorie_id}}"
          }
        },
        {
          "name": "11.8 DELETE /admin/categories/:id (soft delete) ★",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "if (!pm.collectionVariables.get('categorie_id')) throw new Error('categorie_id manquant.');"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 ou 409', () => pm.expect([200,409]).to.include(pm.response.code));",
                  "if (pm.response.code === 200) pm.expect(pm.response.json()).to.have.property('deleted_at');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/admin/categories/{{categorie_id}}"
          }
        }
      ]
    }
  ]
}
