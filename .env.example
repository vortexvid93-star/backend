# Application
# NODE_ENV: development | production | test
NODE_ENV=development
# PORT: HTTP port for the NestJS API (global prefix /api is added in code)
PORT=3000

# Database PostgreSQL
# DB_HOST: database hostname (use `postgres` in Docker Compose network)
DB_HOST=localhost
# DB_PORT: PostgreSQL port
DB_PORT=5432
# DB_USERNAME: database user
DB_USERNAME=bibliotech_user
# DB_PASSWORD: database password (replace in production)
DB_PASSWORD=bibliotech_password
# DB_NAME: database name
DB_NAME=bibliotech_db

# JWT
# JWT_SECRET: signing secret for access tokens (use a long random string in production)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
# JWT_EXPIRES_IN: access token lifetime (e.g. 7d, 15m)
JWT_EXPIRES_IN=7d
# JWT_REFRESH_SECRET: signing secret for refresh tokens
JWT_REFRESH_SECRET=your-refresh-secret
# JWT_REFRESH_EXPIRES_IN: refresh token lifetime
JWT_REFRESH_EXPIRES_IN=30d

# Google OAuth
# GOOGLE_CLIENT_ID: OAuth client ID from Google Cloud Console
GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET: OAuth client secret
GOOGLE_CLIENT_SECRET=your-google-client-secret
# GOOGLE_CALLBACK_URL: must match authorized redirect URI in Google Console
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Firebase (Push Notifications)
# FIREBASE_PROJECT_ID: GCP project id used by Firebase Admin
FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_PRIVATE_KEY: service account private key (escape newlines if needed)
FIREBASE_PRIVATE_KEY=your-firebase-private-key
# FIREBASE_CLIENT_EMAIL: service account client email
FIREBASE_CLIENT_EMAIL=your-firebase-client-email

# MTN Money
# MTN_BASE_URL: MoMo API base URL (sandbox or production)
MTN_BASE_URL=https://sandbox.momodeveloper.mtn.com
# MTN_SUBSCRIPTION_KEY: product subscription key from MTN MoMo portal
MTN_SUBSCRIPTION_KEY=your-mtn-subscription-key
# MTN_API_USER: API user reference
MTN_API_USER=your-mtn-api-user
# MTN_API_KEY: API key for the API user
MTN_API_KEY=your-mtn-api-key

# Airtel Money
# AIRTEL_BASE_URL: Airtel Open API base URL
AIRTEL_BASE_URL=https://openapi.airtel.africa
# AIRTEL_CLIENT_ID: OAuth client id
AIRTEL_CLIENT_ID=your-airtel-client-id
# AIRTEL_CLIENT_SECRET: OAuth client secret
AIRTEL_CLIENT_SECRET=your-airtel-client-secret

# Storage
# STORAGE_PATH: local directory for uploaded files
STORAGE_PATH=./uploads
# MAX_FILE_SIZE_MB: maximum upload size in megabytes
MAX_FILE_SIZE_MB=50
