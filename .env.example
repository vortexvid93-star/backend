# PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/bibliotech?schema=public"

# Docker Compose (dev) — utilisés par le service postgres et l'override DATABASE_URL de l'app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=bibliotech
# Port exposé sur la machine hôte (Docker dev) — 5433 évite le conflit avec Postgres local :5432
POSTGRES_PORT=5433

# JWT & OTP
JWT_SECRET="changez-moi-jwt-secret-long-et-aleatoire"
OTP_HMAC_SECRET="changez-moi-otp-hmac-secret-long-et-aleatoire"

# Email — OTP connexion et réinitialisation mot de passe
# console = journalise le code en dev | smtp | resend
EMAIL_PROVIDER=smtp
RESEND_API_KEY="re_xxxxxxxx"
RESEND_FROM_EMAIL="onboarding@resend.dev"

# SMTP (Gmail exemple) — activez la validation en 2 étapes puis créez un « Mot de passe d'application »
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=votre.email@gmail.com
SMTP_PASSWORD=mot-de-passe-application-16-caracteres
SMTP_FROM_EMAIL=votre.email@gmail.com
SMTP_FROM_NAME=BiblioTech

# Google OAuth2 (Sign-In mobile)
# Client Web — vérification id_token côté backend
GOOGLE_CLIENT_ID=
# Optionnel : clients natifs (audiences supplémentaires pour id_token Android/iOS)
# GOOGLE_ANDROID_CLIENT_ID=
# GOOGLE_IOS_CLIENT_ID="votre-client-id.apps.googleusercontent.com"

# Cloudinary (images : couvertures, badges, photos de profil)
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# Cloudflare R2 (fichiers livres INTERNE : PDF, EPUB, MOBI)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=bi-links-documents
R2_ENDPOINT=https://VOTRE_ACCOUNT_ID.r2.cloudflarestorage.com

# Serveur
PORT=3000
NODE_ENV=development

# CORS — origines autorisées (séparées par des virgules)
# Ex. frontend Vite, Expo web, admin local
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:3001,http://127.0.0.1:3001
# CORS_ORIGINS=*  → autorise toutes les origines (déconseillé en prod)

# Jobs cron (@nestjs/schedule) — false pour désactiver en dev local
CRON_ENABLED=true

# Paiements — pawapay (intégration Mobile Money) | mock (debug sans ngrok uniquement)
PAYMENT_PROVIDER=pawapay
# URL publique HTTPS (ngrok en dev) — webhooks + retours navigateur
PAYMENT_PUBLIC_BASE_URL=https://VOTRE-ID.ngrok-free.app

# PawaPay — dépôts abonnement (sandbox | production)
# sandbox → api.sandbox.pawapay.io | production → api.pawapay.io (si PAWAPAY_API_URL vide)
PAWAPAY_MODE=sandbox
# PAWAPAY_API_URL=https://api.sandbox.pawapay.io
PAWAPAY_API_TOKEN=
# URL publique (ngrok / domaine prod) — identique aux Callback URLs du dashboard
PAWAPAY_PUBLIC_BASE_URL=https://VOTRE-ID.ngrok-free.app
# MTN_MOMO_COG | AIRTEL_COG (sinon auto : 24206… MTN, 24205… / 24204… Airtel)
PAWAPAY_DEFAULT_PROVIDER=MTN_MOMO_COG
PAWAPAY_DEFAULT_CURRENCY=XAF
# Dashboard → Deposits: {PAWAPAY_PUBLIC_BASE_URL}/api/webhooks/pawapay/deposits

# Rétention des jetons d'accès lecture (token_lecture) pour stats nb_lectures_7j
TOKEN_LECTURE_RETENTION_DAYS=7

# YouTube Data API v3 — récupération des vidéos éducatives
# Clé à créer sur https://console.cloud.google.com → APIs & Services → Credentials
YOUTUBE_API_KEY=
# Fréquence de synchronisation (cron expression, défaut : tous les jours à 06h00 UTC)
YOUTUBE_SYNC_CRON="0 6 * * *"
